<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_selector.xml
    Sélecteur de couleur pour les icônes et textes de la BottomNavigationView.
    Actif → couleur primaire | Inactif → gris
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:color="@color/nav_selected" />
    <item
        android:color="@color/nav_unselected" />
</selector>
